<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices older than API 31 (ignored on Android 12+).

   clf_prefs holds the "remember me" credentials, so it must never leave the
   device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="clf_prefs.xml" />
</full-backup-content>
