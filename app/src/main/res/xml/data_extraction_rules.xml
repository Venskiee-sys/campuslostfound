<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices running Android 12+.

   clf_prefs holds the "remember me" credentials, so it must never leave the
   device: it is excluded from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="clf_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="clf_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
