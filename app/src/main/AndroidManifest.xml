<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Blue dot + "My location" on the campus map picker -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/plmunlogo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/plmunlogo"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusLostFound">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CampusLostFound"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google Maps API Key (supplied by manifestPlaceholders["MAPS_API_KEY"]
             in app/build.gradle.kts; set maps.apiKey in gradle.properties) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
    </application>

</manifest>